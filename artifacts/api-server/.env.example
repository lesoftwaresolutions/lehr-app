# Copy this to .env for local development.
# In Vercel, set these under Project Settings → Environment Variables.

# Required: Supabase project URL (NOT the VITE_ prefixed version — that's browser-only)
SUPABASE_URL=https://your-project.supabase.co

# Required: Supabase service role key (never expose this to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Required: Port for local development
PORT=3001

# Optional: Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins (useful for local dev).
# In production set to your frontend URL, e.g.: https://lehr-app.vercel.app
ALLOWED_ORIGINS=
