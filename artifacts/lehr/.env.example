# Copy this to .env for local development.
# In Vercel, set these under Project Settings → Environment Variables.

# Required: Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Required: Your Supabase anon (public) key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required: Full URL to your deployed API server (the lehr-app-api-server Vercel project).
# For local dev, leave empty to proxy through Vite's /api dev proxy.
# In production: https://lehr-app-api-server.vercel.app
VITE_API_BASE_URL=
