{
  "name": "lehr",
  "buildCommand": "pnpm --filter @workspace/lehr run build:vercel",
  "outputDirectory": "artifacts/lehr/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/clock/:id", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
