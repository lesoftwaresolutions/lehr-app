# ============================================================================
# LEHR — environment variables
# Copy to .env for local dev. In production set these in Vercel
# (Project → Settings → Environment Variables). NEVER commit real values.
# ============================================================================

# ---- Client (Vite, exposed to the browser — safe, public keys only) ----
VITE_SUPABASE_URL=https://drhseqszhnnbeifvpfmx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Server (Vercel serverless functions in /api — SECRET, never VITE_) ----
SUPABASE_URL=https://drhseqszhnnbeifvpfmx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe secret key (Dashboard → Developers → API keys). Use sk_test_... first.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (Dashboard → Developers → Webhooks → your endpoint).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Recurring Price IDs (Dashboard → Product catalogue → each product → Pricing).
STRIPE_PRICE_MICRO=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PROFESSIONAL=price_xxx

# Optional: absolute base URL used for Stripe success/cancel/return URLs.
# If unset, the functions derive it from the request Origin/Host header.
# PUBLIC_BASE_URL=https://your-domain.com
